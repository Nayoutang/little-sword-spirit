	["回来就好。坐近些，我听着。", "我刚才还在想，你什么时候到。", "累了吧？先坐下，剑给我。"],
	["回来啦。你的位置，我留着呢。", "就等你了。今天想做什么都行。", "我听见你的脚步声了。进来吧。"],
]


static func greeting(stage: int, recent: Array[String] = []) -> String:
	var lines: Array = GREETINGS[clampi(stage, 0, 3)]
	var fresh: Array = lines.filter(func(line): return not recent.has(line))
	var pool: Array = fresh if not fresh.is_empty() else lines
	return str(pool[randi_range(0, pool.size() - 1)])


# 优先挑两句回复都没在最近说过的话题；全都说过时随机挑。
static func pick_topic(stage: int, recent: Array[String] = []) -> int:
	var fresh: Array[int] = []
	var replies: Array = REPLIES[clampi(stage, 0, 3)]
	for topic in range(TOPICS.size()):
		if not recent.has(str(replies[topic][0])) and not recent.has(str(replies[topic][1])):
			fresh.append(topic)
	if fresh.is_empty():
		return randi_range(0, TOPICS.size() - 1)
	return fresh[randi_range(0, fresh.size() - 1)]

static func event_opening(event_id: String) -> String:
	return str(EVENT_OPENINGS.get(event_id, ""))

static func choices(event_id: String, _stage: int, topic: int) -> Array:
	if EVENTS.has(event_id):
		return [EVENTS[event_id][0], EVENTS[event_id][1]]
	return TOPICS[posmod(topic, TOPICS.size())]

static func answer(event_id: String, stage: int, topic: int, index: int) -> String:
	if EVENTS.has(event_id):
		return EVENTS[event_id][2 + index]
	return REPLIES[clampi(stage, 0, 3)][posmod(topic, TOPICS.size())][index]

static func homecoming(journal: Array) -> String:
	var result := ""
	var moment := ""
	var promise := ""
	for fact: Dictionary in journal:
		var category := str(fact.get("category", ""))
		var summary := str(fact.get("summary", ""))
		if category == "run_result":
			result = "这趟路走完了。先坐下，别急着再出门。" if summary.contains("通关") else "这回没走到最后也没关系。回来歇好，我们再走。"
		elif category == "adventure":
			var begin := summary.find("「")
			var end := summary.find("」", begin + 1)
			if begin >= 0 and end > begin:
				moment = "途中那段「%s」，我还记得。" % summary.substr(begin + 1, end - begin - 1)
		elif category == "promise_result":
			promise = "答应我的事没做到，下回可要记住。" if summary.contains("未兑现") else "答应我的事，你做到了。我记着呢。"
	return " ".join([result, moment, promise]).strip_edges() if not result.is_empty() else "回来了。先歇会儿，路上的事慢慢说。"
